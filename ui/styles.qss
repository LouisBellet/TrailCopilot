QMainWindow {
    background-color: #16191E;
}

QWidget {
    background-color: #16191E;
    color: #E2E8F0;
    font-family: 'Segoe UI', -apple-system, sans-serif;
}

QTabWidget::pane {
    border: 1px solid #2D3748;
    background-color: #16191E;
    border-radius: 4px;
}

QTabBar::tab {
    background-color: #1F242D;
    color: #A0AEC0;
    padding: 10px 20px;
    margin-right: 2px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    font-weight: bold;
    font-size: 13px;
}

QTabBar::tab:selected {
    background-color: #2D3748;
    color: #38B2AC;
    border-bottom: 2px solid #38B2AC;
}

QTabBar::tab:hover {
    background-color: #283141;
    color: #E2E8F0;
}

QSplitter::handle {
    background-color: #2D3748;
    width: 2px;
}

QGroupBox {
    border: 1px solid #2D3748;
    border-radius: 6px;
    margin-top: 10px;
    padding-top: 10px;
    font-weight: bold;
    color: #4FD1C5;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px;
}

QTableWidget {
    background-color: #1F242D;
    border: 1px solid #2D3748;
    border-radius: 6px;
    gridline-color: #2D3748;
    font-size: 12px;
    selection-background-color: #2B6CB0;
}

QHeaderView::section {
    background-color: #262D38;
    color: #CBD5E0;
    padding: 6px;
    border: 1px solid #2D3748;
    font-weight: bold;
}

QLabel {
    font-size: 13px;
}

QListWidget {
    background-color: #1F242D;
    border: 1px solid #2D3748;
    border-radius: 6px;
    padding: 4px;
    font-size: 13px;
}

QListWidget::item {
    background-color: #262D38;
    border-radius: 4px;
    padding: 8px;
    margin-bottom: 5px;
    border-left: 4px solid #4A5568;
}

QListWidget::item:selected {
    background-color: #2D3748;
    border-left: 4px solid #38B2AC;
}

QPushButton {
    background-color: #319795;
    color: white;
    border: none;
    border-radius: 5px;
    padding: 9px 14px;
    font-weight: bold;
    font-size: 13px;
}

QPushButton:hover {
    background-color: #2C7A7B;
}

QPushButton:disabled {
    background-color: #2D3748;
    color: #718096;
}

QComboBox {
    background-color: #1F242D;
    border: 1px solid #2D3748;
    border-radius: 5px;
    padding: 6px 12px;
    color: white;
    font-size: 13px;
}

QProgressBar {
    border: 1px solid #2D3748;
    border-radius: 4px;
    text-align: center;
    background-color: #1F242D;
    color: white;
}

QProgressBar::chunk {
    background-color: #38B2AC;
}

QTextBrowser {
    background-color: #1F242D;
    border: 1px solid #2D3748;
    border-radius: 6px;
    padding: 10px;
    font-size: 13px;
}